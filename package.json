{
  "name": "nostr-commerce-skill",
  "version": "3.0.0",
  "description": "Agentic AI skill for Nostr commerce + Music License Link (x402 lnbtc, artist-signed licence offers, proof of release) \u2014 NIP-47/57/99/59/40/50/56/22/98/94/03 + Lightning L402",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "SKILL.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm run typecheck",
    "demo:music": "tsx examples/music-license-link-demo.ts",
    "mcp:music": "tsx src/bin/music-license-mcp.ts"
  },
  "dependencies": {
    "@getalby/lightning-tools": "^5.0.0",
    "@getalby/sdk": "^3.6.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@scure/base": "^1.2.0",
    "canonicalize": "^2.1.0",
    "light-bolt11-decoder": "^3.2.0",
    "nostr-tools": "^2.7.0",
    "opentimestamps": "^0.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "dotenv": "^17.4.2",
    "tsx": "^4.22.1",
    "typescript": "^5.4.0",
    "vitest": "^4.1.6",
    "ws": "^8.20.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "music-license-mcp": "./dist/bin/music-license-mcp.js"
  }
}
